# ── BEYONDVYU server env template (NO SECRETS — copy to .env and fill in) ──
# cp .env.example .env   (then paste keys; server picks up OPENROUTER_* without restart)

DATABASE_URL="postgresql://user:password@localhost:5432/reviewos?schema=public"
JWT_SECRET="paste-32-plus-char-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV="development"
SMTP_FROM="you@example.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="you@example.com"
SMTP_PASS="NEED_GMAIL_APP_PASSWORD"
# Public frontend origin(s), comma-separated. In production this must be the
# HTTPS origin users see, e.g. https://beyondvyu.com. It is also used to build
# the Meta data-deletion status URL.
FRONTEND_URL="http://localhost:3000"

SMS_API_KEY="CHANGE_ME_SMS_API_KEY"
SMS_SENDER_ID="SMSFRU"
SMS_TEMPLATE_ID=""
SMS_BASE_URL="https://login.smsforyou.biz/V2/http-api.php"

GEMINI_API_KEY_1="paste-gemini-key"
GOOGLE_GENERATIVE_AI_API_KEY=""

GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/api/google-reviews/oauth/callback"
GOOGLE_OAUTH_AUTH_REDIRECT_URI=""
TOKEN_ENCRYPTION_KEY="paste-32-byte-hex"

GOOGLE_PLACES_API_KEY=""

# ── AI failover (chain: Gemini primary → OpenRouter DeepSeek → offline) ──
# HOW TO ENABLE (paste key, NO server restart needed — it is hot-picked from .env):
#   1. Create key at https://openrouter.ai/keys (add a few $ credits)
#   2. Paste as OPENROUTER_API_KEY="sk-or-v1-..." (keep the quotes)
#   3. Responses will include "provider": "gemini"|"openrouter"|"fallback"
# COST: default deepseek/deepseek-chat ≈ $0.27 in / $0.41 out per 1M (≈ $0.0002/draft).
# Verified Sep 2026 for Hinglish drafts + JSON talking-points.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-chat"

# WhatsApp Business Platform — multi-tenant Tech Provider setup.
# Each business connects its OWN WABA / Messaging account and phone number
# through Embedded Signup. Never use a single shared BEYONDVYU number for
# client-to-customer messaging, and never put a client token here.
#
# Where these values come from (Meta for Developers):
# 1. WHATSAPP_APP_ID / WHATSAPP_APP_SECRET
#    App Dashboard > App settings > Basic. The secret is the App Secret.
#    Do NOT put a client/partner system-user token in either field.
# 2. WHATSAPP_ES_CONFIG_ID
#    App Dashboard > Facebook Login for Business > Configurations.
#    Create an "Embedded Signup" configuration, select Cloud API (and WhatsApp
#    Business app onboarding if you want coexistence), copy the Configuration ID.
# 3. WHATSAPP_WEBHOOK_VERIFY_TOKEN
#    Any long random string you invent. Paste the same value in Meta's webhook
#    configuration. The webhook URL is https://<api-host>/api/v2/whatsapp/webhook.
# 4. WHATSAPP_ES_FEATURE_TYPE
#    Leave as whatsapp_business_app_onboarding to let a business keep using the
#    WhatsApp Business app on its phone. Set to an empty string to force a
#    Cloud API-only number.
WHATSAPP_APP_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_ES_CONFIG_ID=""
WHATSAPP_ES_VERSION="v4"
WHATSAPP_ES_FEATURE_TYPE="whatsapp_business_app_onboarding"
WHATSAPP_API_VERSION="v25.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="set-any-long-random-string-here"
# Official Meta destinations shown in the owner dashboard. Each client pays
# Meta directly; BEYONDVYU never pays or marks up Meta message fees.
WHATSAPP_BILLING_URL="https://business.facebook.com/billing_hub/accounts/"
WHATSAPP_MANAGER_URL="https://business.facebook.com/wa/manage/home/"
# Optional: external scheduler secret for POST /api/v2/whatsapp/process-due.
# The server also runs an in-process due-message job when the Meta app is set.
WHATSAPP_CRON_SECRET=""

# Meta Platform Terms callbacks (built in, verified with WHATSAPP_APP_SECRET):
#   Deauthorize:  https://<api-host>/api/meta/deauthorize
#   Data deletion: https://<api-host>/api/meta/data-deletion
# The data-deletion callback returns a status URL under FRONTEND_URL.

# These META_* aliases are also accepted if you copy them from a Meta tutorial:
#   META_APP_ID, META_APP_SECRET, META_GRAPH_API_VERSION,
#   META_EMBEDDED_SIGNUP_CONFIG_ID, META_WEBHOOK_VERIFY_TOKEN
# WHATSAPP_* wins when both names are set.

INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_WEBHOOK_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
INSTAGRAM_ACCESS_TOKEN=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

ADMIN_EMAIL="admin@beyondvyu.app"
ADMIN_PASSWORD_HASH=""
ADMIN_JWT_SECRET="paste-32-plus-char-random-string"
ADMIN_PATH_PREFIX="admin"
