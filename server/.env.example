# ── BEYONDVYU server env template (NO SECRETS — copy to .env and fill in) ──
# cp .env.example .env   (then paste keys; server picks up OPENROUTER_* without restart)

DATABASE_URL="postgresql://user:password@localhost:5432/reviewos?schema=public"
JWT_SECRET="paste-32-plus-char-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV="development"
SMTP_FROM="you@example.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="you@example.com"
SMTP_PASS="NEED_GMAIL_APP_PASSWORD"
FRONTEND_URL="http://localhost:3000"

SMS_API_KEY="CHANGE_ME_SMS_API_KEY"
SMS_SENDER_ID="SMSFRU"
SMS_TEMPLATE_ID=""
SMS_BASE_URL="https://login.smsforyou.biz/V2/http-api.php"

GEMINI_API_KEY_1="paste-gemini-key"
GOOGLE_GENERATIVE_AI_API_KEY=""

GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/api/google-reviews/oauth/callback"
GOOGLE_OAUTH_AUTH_REDIRECT_URI=""
TOKEN_ENCRYPTION_KEY="paste-32-byte-hex"

GOOGLE_PLACES_API_KEY=""

# ── AI failover (chain: Gemini primary → OpenRouter DeepSeek → offline) ──
# HOW TO ENABLE (paste key, NO server restart needed — it is hot-picked from .env):
#   1. Create key at https://openrouter.ai/keys (add a few $ credits)
#   2. Paste as OPENROUTER_API_KEY="sk-or-v1-..." (keep the quotes)
#   3. Responses will include "provider": "gemini"|"openrouter"|"fallback"
# COST: default deepseek/deepseek-chat ≈ $0.27 in / $0.41 out per 1M (≈ $0.0002/draft).
# Verified Sep 2026 for Hinglish drafts + JSON talking-points.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-chat"

WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v25.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="set-any-random-string-here"

INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_WEBHOOK_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

ADMIN_EMAIL="admin@beyondvyu.app"
ADMIN_PASSWORD_HASH=""
ADMIN_JWT_SECRET="paste-32-plus-char-random-string"
ADMIN_PATH_PREFIX="admin"
